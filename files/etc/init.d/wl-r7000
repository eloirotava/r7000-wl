#!/bin/sh /etc/rc.common
# wl (Broadcom 7.14, BCM4360) no R7000: carrega o driver antes da rede.
# Os radios sao configurados pelo netifd (/etc/config/wireless, type
# broadcom) via /lib/netifd/wireless/broadcom.sh.

START=19
USE_PROCD=1

FAILS=/etc/wl-r7000.fails

log() { logger -t wl-r7000 "$*"; }

# protecao contra boot-loop: so starts de boot contam.  Depois de max_fails
# boots seguidos sem ficar estavel por stable_secs, o wl nao carrega.
guard_check() {
	local max n up
	config_get max guard max_fails 3
	up=$(cut -d. -f1 /proc/uptime)
	[ "$up" -lt 600 ] || return 0		# restart manual: nao conta
	n=$(cat "$FAILS" 2>/dev/null || echo 0)
	if [ "$n" -ge "$max" ]; then
		log "wl desativado: $n boots sem estabilizar (apague $FAILS para tentar de novo)"
		return 1
	fi
	echo $((n + 1)) > "$FAILS"; sync
	GUARD_ARMED=1
	return 0
}

# zera o contador depois de stable_secs: instancia do procd, para nao
# herdar o lock do rc.common (um "sleep &" aqui travava stop/restart)
guard_reset_instance() {
	local stable
	config_get stable guard stable_secs 600
	procd_open_instance guard
	procd_set_param command /bin/sh -c "sleep $stable; echo 0 > $FAILS; sync"
	procd_close_instance
}

load_wl() {
	local d
	for d in /sys/bus/pci/drivers/bcma-pci-bridge/*:*; do
		[ -e "$d" ] || continue
		case "$(cat "$d/vendor"):$(cat "$d/device")" in
		0x14e4:0x43a0|0x14e4:0x43a1|0x14e4:0x43a2|0x14e4:0x4360)
			echo "$(basename "$d")" > /sys/bus/pci/drivers/bcma-pci-bridge/unbind ;;
		esac
	done
	grep -q '^wl ' /proc/modules || insmod wl || return 1
}

start_service() {
	config_load wl-r7000
	guard_check || return 0
	load_wl || { log "falha ao carregar o wl"; return 1; }
	[ -n "$GUARD_ARMED" ] && guard_reset_instance
}
