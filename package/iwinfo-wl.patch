+/* chanspec do 7.x (formato d11ac): banda 0xc000, largura 0x3800, canal
+ * (centro, em 40/80) nos 8 bits de baixo */
+static int wl_get_chanspec(const char *ifname, uint32_t *cs)
+{
+	char buf[256];
+
+	memset(buf, 0, sizeof(buf));
+	if (wl_iovar(ifname, "chanspec", NULL, 0, buf, sizeof(buf)))
+		return -1;
+
+	memcpy(cs, buf, sizeof(*cs));
+	return 0;
+}
+
 static int wl_get_center_chan1(const char *ifname, int *buf)
+{
+	uint32_t cs;
+
+	if (wl_get_chanspec(ifname, &cs))
+		return -1;
+
+	*buf = cs & 0xff;
+	return 0;
+}
+
+static int wl_get_htmode(const char *ifname, int *buf)
+{
+	uint32_t cs;
+	int vht = 0;
+
+	if (wl_get_chanspec(ifname, &cs))
+		return -1;
+
+	vht = ((cs & 0xc000) == 0xc000);
+
+	switch (cs & 0x3800)
+	{
+	case 0x1000: *buf = vht ? IWINFO_HTMODE_VHT20 : IWINFO_HTMODE_HT20; break;
+	case 0x1800: *buf = vht ? IWINFO_HTMODE_VHT40 : IWINFO_HTMODE_HT40; break;
+	case 0x2000: *buf = IWINFO_HTMODE_VHT80; break;
+	case 0x2800: *buf = IWINFO_HTMODE_VHT160; break;
+	default: return -1;
+	}
+
+	return 0;
+}
