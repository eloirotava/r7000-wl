+/* sem wext neste kernel: frequencia, potencia, qualidade, scan e canais
+ * vao direto nos ioctls do wl */
+#define WLC_SCAN			50
+#define WLC_SCAN_RESULTS		51
+#define WLC_GET_VALID_CHANNELS		217
+
+static int wl_ch2mhz(int ch)
+{
+	if (ch == 14)
+		return 2484;
+	return (ch < 14) ? 2407 + ch * 5 : 5000 + ch * 5;
+}
