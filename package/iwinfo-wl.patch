+/* wl_bss_info_t versao 109 (driver 7.x), por offset */
+static void wl_scan_entry(uint8_t *b, uint32_t blen, struct iwinfo_scanlist_entry *e)
+{
+	uint16_t cap, ieoff;
+	uint32_t ielen, i;
+	int16_t rssi;
+	int sig;
+
+	memset(e, 0, sizeof(*e));
+	memcpy(e->mac, b + 8, 6);
+	memcpy(e->ssid, b + 19, b[18] > IWINFO_ESSID_MAX_SIZE ? IWINFO_ESSID_MAX_SIZE : b[18]);
+	memcpy(&cap, b + 16, 2);
+	memcpy(&rssi, b + 78, 2);
+	memcpy(&ieoff, b + 116, 2);
+	memcpy(&ielen, b + 120, 4);
+
+	e->mode = (cap & 0x1) ? IWINFO_OPMODE_MASTER : IWINFO_OPMODE_ADHOC;
+	e->channel = b[88];
+	e->mhz = wl_ch2mhz(e->channel);
+	e->band = (e->channel <= 14) ? IWINFO_BAND_24 : IWINFO_BAND_5;
+	e->signal = rssi + 0x100;
+	sig = rssi + 110;
+	e->quality = sig < 0 ? 0 : (sig > 70 ? 70 : sig);
+	e->quality_max = 70;
+	e->crypto.enabled = !!(cap & 0x10);
+
+	if (ieoff + ielen > blen)
+		return;
+
+	/* RSN (48) e WPA vendor (221, 00:50:f2:01) */
+	for (i = ieoff; i + 2 <= ieoff + ielen && i + 2 + b[i + 1] <= ieoff + ielen; i += 2 + b[i + 1])
+	{
+		uint8_t *ie = b + i;
+
+		if (ie[0] == 48)
+			iwinfo_parse_rsn(&e->crypto, ie + 2, ie[1],
+			                 IWINFO_CIPHER_CCMP, IWINFO_KMGMT_8021x);
+		else if (ie[0] == 221 && ie[1] >= 4 && !memcmp(ie + 2, "\x00\x50\xf2\x01", 4))
+			iwinfo_parse_rsn(&e->crypto, ie + 6, ie[1] - 4,
+			                 IWINFO_CIPHER_TKIP, IWINFO_KMGMT_PSK);
+	}
+}
