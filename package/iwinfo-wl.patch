 static int wl_get_scanlist(const char *ifname, char *buf, int *len)
 {
-	return wext_ops.scanlist(ifname, buf, len);
+	uint32_t ssid_len = 0, count, off, i, blen;
+	uint8_t *res;
+	int tries, n = 0;
+	const int max = 64 * 1024;
+
+	/* so o wlc_ssid_t vazio: com o wl_scan_params_t inteiro o 7.x aceita e
+	 * nao acha nada */
+	if (wl_ioctl(ifname, WLC_SCAN, &ssid_len, sizeof(ssid_len)))
+		return -1;
+
+	if (!(res = malloc(max)))
+		return -1;
+
+	for (tries = 0; tries < 40; tries++)
+	{
+		usleep(250000);
+		memset(res, 0, 12);
+		*(uint32_t *)res = max;
+
+		if (!wl_ioctl(ifname, WLC_SCAN_RESULTS, res, max) && ((uint32_t *)res)[2])
+			break;
+	}
+
+	count = ((uint32_t *)res)[2];
+	for (i = 0, off = 12; i < count && off + 128 <= (uint32_t)max; i++, off += blen)
+	{
+		memcpy(&blen, res + off + 4, 4);
+		if (blen < 128 || off + blen > (uint32_t)max)
+			break;
+
+		if ((n + 1) * sizeof(struct iwinfo_scanlist_entry) > IWINFO_BUFSIZE)
+			break;
+
+		wl_scan_entry(res + off, blen, (struct iwinfo_scanlist_entry *)buf + n++);
+	}
+
+	free(res);
+	*len = n * sizeof(struct iwinfo_scanlist_entry);
+	return 0;
 }
 
