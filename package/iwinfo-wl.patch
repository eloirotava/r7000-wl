+	memset(l, 0, sizeof(l));
+	l[0] = 127;
+	if (wl_ioctl(ifname, WLC_GET_VALID_CHANNELS, l, sizeof(l)))
+		return -1;
+
+	for (i = 0; i < (int)l[0] && i < 127; i++, e++)
+	{
+		memset(e, 0, sizeof(*e));
+		e->channel = l[i + 1];
+		e->mhz = wl_ch2mhz(e->channel);
+		e->band = (e->channel <= 14) ? IWINFO_BAND_24 : IWINFO_BAND_5;
+	}
+
+	*len = i * sizeof(struct iwinfo_freqlist_entry);
+	return 0;
 }
 
