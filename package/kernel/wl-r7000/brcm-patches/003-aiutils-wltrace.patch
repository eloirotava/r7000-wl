+/* build com wltrace: escritas no ioctrl dos cores (flags de reset do d11),
+ * para comparar com o b43.  So escritas que nao sejam so o FGC; ate 300. */
+#ifdef WLTRACE
+static int wlt_ioc_n;
+#define WLT_IOC(what, v) do { \
+	if (wlt_ioc_n++ < 300) \
+		printk(KERN_INFO "wltrace-ioc %s core %x/%u ioctrl %08x ioctrl_le %08x\n", \
+		       what, si_coreid(&sii->pub), si_coreidx(&sii->pub), (v), \
+		       R_REG(sii->osh, &ai->ioctrl)); \
+} while (0)
+#else
+#define WLT_IOC(what, v) do {} while (0)
+#endif
