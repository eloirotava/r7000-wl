+/* TX chain masks (bits 6..8 of PhyTxControlWord_0): one spatial stream,
+ * two spatial streams. 1 / 3 are what the MacBook port used; the R7000 has
+ * three chains with an external PA each. */
+unsigned int b43_ac_txmask_1ss = 1;
+module_param_named(ac_txmask_1ss, b43_ac_txmask_1ss, uint, 0644);
+MODULE_PARM_DESC(ac_txmask_1ss, "AC-PHY: TX chain mask for 1-stream and legacy frames (1..7)");
+static unsigned int b43_ac_txmask_2ss = 3;
+module_param_named(ac_txmask_2ss, b43_ac_txmask_2ss, uint, 0644);
+MODULE_PARM_DESC(ac_txmask_2ss, "AC-PHY: TX chain mask for 2-stream frames (3, 5, 6 or 7)");
+#define B43_AC_TXM(two)	((((two) ? b43_ac_txmask_2ss : b43_ac_txmask_1ss) & 7) << 6)
+
 static unsigned int b43_ac_ampdu_mpdus = 4;
 module_param_named(ac_ampdu_mpdus, b43_ac_ampdu_mpdus, uint, 0644);
 MODULE_PARM_DESC(ac_ampdu_mpdus, "AC-PHY: max MPDUs per A-MPDU in the TX header (the captured wl value was 4)");
