+/* depuracao no R7000: quantas ops do replay rodar (-1 = todas) e intervalo
+ * de checkpoints (mensagem + 1,5 s de espera para o log chegar ao flash) */
+static int ac_replay_ops = -1;
+module_param(ac_replay_ops, int, 0444);
