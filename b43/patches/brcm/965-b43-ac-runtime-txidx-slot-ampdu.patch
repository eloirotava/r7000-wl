@@ -13,6 +13,9 @@
 #include "dma.h"
 #include "main.h"
 
+/* last attached AC-PHY device, for module parameters applied at runtime */
+static struct b43_wldev *b43_ac_cur_dev;
+
 #ifdef CPTCFG_B43_PHY_AC_DEBUG
 #include <linux/debugfs.h>
 #include <linux/seq_file.h>
@@ -432,6 +435,7 @@
 	if (!phy_ac)
 		return -ENOMEM;
 	dev->phy.ac = phy_ac;
+	b43_ac_cur_dev = dev;
 
 #ifdef CPTCFG_B43_PHY_AC_DEBUG
 	if (!b43_ac_dbg_dir) {
@@ -469,6 +473,8 @@
 	struct b43_phy *phy = &dev->phy;
 	struct b43_phy_ac *phy_ac = phy->ac;
 
+	if (b43_ac_cur_dev == dev)
+		b43_ac_cur_dev = NULL;
 #ifdef CPTCFG_B43_PHY_AC_DEBUG
 	if (b43_ac_dbg_dev == dev) {
 		debugfs_remove_recursive(b43_ac_dbg_dir);
@@ -887,10 +893,30 @@
 module_param_named(ac_fem3_sub3, b43_ac_fem3_sub3, bool, 0444);
 MODULE_PARM_DESC(ac_fem3_sub3, "program the femctrl 3 sub 3 FEM LUT (R7000 2.4 GHz) when the SROM femctrl is not 2");
 static unsigned int b43_ac_txidx_2g = 20;
-module_param_named(ac_txidx_2g, b43_ac_txidx_2g, uint, 0644);
-MODULE_PARM_DESC(ac_txidx_2g, "2.4 GHz TX gain table index (0 = highest gain), applied on channel switch");
 static void b43_phy_ac_txpwr_by_index(struct b43_wldev *dev, unsigned int idx);
 
+/* Writing the parameter also applies it to the running 2.4 GHz radio. */
+static int b43_ac_txidx_2g_set(const char *val, const struct kernel_param *kp)
+{
+	struct b43_wldev *dev = b43_ac_cur_dev;
+	int err = param_set_uint(val, kp);
+
+	if (err || !dev)
+		return err;
+	mutex_lock(&dev->wl->mutex);
+	if (b43_status(dev) >= B43_STAT_INITIALIZED &&
+	    b43_current_band(dev->wl) == NL80211_BAND_2GHZ)
+		b43_phy_ac_txpwr_by_index(dev, b43_ac_txidx_2g);
+	mutex_unlock(&dev->wl->mutex);
+	return 0;
+}
+static const struct kernel_param_ops b43_ac_txidx_2g_ops = {
+	.set = b43_ac_txidx_2g_set,
+	.get = param_get_uint,
+};
+module_param_cb(ac_txidx_2g, &b43_ac_txidx_2g_ops, &b43_ac_txidx_2g, 0644);
+MODULE_PARM_DESC(ac_txidx_2g, "2.4 GHz TX gain table index (0 = highest gain); applied at once and on channel switch");
+
 module_param_named(ac_por, b43_ac_por, uint, 0444);
 MODULE_PARM_DESC(ac_por, "ignored, kept so old command lines still load");
 
