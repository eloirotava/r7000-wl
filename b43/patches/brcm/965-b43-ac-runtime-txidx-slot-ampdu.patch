diff -ruN a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
--- a/drivers/net/wireless/broadcom/b43/main.c	2026-10-30 19:10:10.162377922 -0300
+++ b/drivers/net/wireless/broadcom/b43/main.c	2026-10-30 19:10:10.252377921 -0300
@@ -808,6 +808,18 @@
 {
 	/* slot_time is in usec. */
 	/* This test used to exit for all but a G PHY. */
+	/*
+	 * Core rev >= 40: wlc_bmac_update_slot_timing writes the IFS slot
+	 * register and shm 0x10 together; b43 zeroes shm before the ucode
+	 * upload, so without this the rev 40+ ucode runs with slot time 0.
+	 */
+	if (dev->phy.type == B43_PHYTYPE_AC) {
+		if (b43_current_band(dev->wl) == NL80211_BAND_5GHZ)
+			slot_time = 9;
+		b43_write16(dev, B43_MMIO_IFSSLOT, 510 + slot_time);
+		b43_shm_write16(dev, B43_SHM_SHARED, 0x0010, slot_time);
+		return;
+	}
 	if (b43_current_band(dev->wl) == NL80211_BAND_5GHZ)
 		return;
 	b43_write16(dev, B43_MMIO_IFSSLOT, 510 + slot_time);
@@ -5242,6 +5254,19 @@
 		hf |= B43_HF_AC_NOPRBRESP;
 	b43_hf_write(dev, hf);
 
+	/*
+	 * wl's MAC timing on core rev >= 40 that b43 leaves at the initvals
+	 * or at 0: wlc_bmac_init clears IFS_CTL bits 12..15 and writes MMIO
+	 * 0x69c = 1; wlc_bmac_bsinit sets the slot time (long until mac80211
+	 * asks for short slot).
+	 */
+	if (dev->phy.type == B43_PHYTYPE_AC) {
+		b43_write16(dev, B43_MMIO_IFSCTL,
+			    b43_read16(dev, B43_MMIO_IFSCTL) & 0x0FFF);
+		b43_write16(dev, 0x69C, 1);
+		b43_set_slot_time(dev, 20);
+	}
+
 	/* tell the ucode MAC capabilities */
 	if (dev->dev->core_rev >= 13) {
 		u32 mac_hw_cap = b43_read32(dev, B43_MMIO_MAC_HW_CAP);
